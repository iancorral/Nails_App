generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Service {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  duration       Int
  price          Float
  description    String?
  category       String        @default("General")
  isActive       Boolean       @default(true)
  appointmentIDs String[]      @db.ObjectId
  appointments   Appointment[] @relation(fields: [appointmentIDs], references: [id])
}

model Appointment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime  @default(now())
  date           DateTime
  endDate        DateTime
  clientName     String
  clientPhone    String
  status         String    @default("CONFIRMED")

  // Pago
  paymentStatus  String    @default("PENDING")   // PENDING | PAID | PARTIAL
  paymentMethod  String?                          // CASH | CARD | TRANSFER
  depositPaid    Boolean   @default(false)
  depositAmount  Float?

  // Precio real (override del catálogo)
  finalPrice     Float?

  // Notas internas (solo ve el admin)
  adminNotes     String?

  // Distinguir si la creó el admin o vino de la web
  createdByAdmin Boolean   @default(false)

  serviceIDs     String[]  @db.ObjectId
  services       Service[] @relation(fields: [serviceIDs], references: [id])
}

model WorkSchedule {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  dayOfWeek Int
  startTime String
  endTime   String
  isDayOff  Boolean  @default(false)
}

model BlockedDate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model Reminder {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String   @db.ObjectId
  clientName    String
  clientPhone   String
  scheduledFor  DateTime
  whatsappUrl   String
  sent          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model AvailabilityOverride {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  isClosed  Boolean  @default(false)
  startTime String?
  endTime   String?
  note      String?
  createdAt DateTime @default(now())
}